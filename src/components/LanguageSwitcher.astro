---
import { translatePath } from '../navigation';

interface Props {
  lang: 'es' | 'en';
  isEn: boolean;
}

const { lang, isEn } = Astro.props;

const targetLang = lang === 'es' ? 'en' : 'es';
const targetPath = translatePath(Astro.url.pathname, lang, targetLang);
const esUrl = lang === 'es' ? Astro.url.pathname : targetPath;
const enUrl = lang === 'en' ? Astro.url.pathname : targetPath;
---

<div class="lang-switcher">
  <a href={esUrl} class="lang-switcher-link">
    <span class="lang-switcher-label {lang !== 'es' ? 'dimmed' : ''}">ES</span>
  </a>
  <span class="lang-switcher-separator">/</span>
  <a href={enUrl} class="lang-switcher-link">
    <span class="lang-switcher-label {lang !== 'en' ? 'dimmed' : ''}">EN</span>
  </a>
</div>
