---
import '../styles/global.css';

interface Props {
  lang: 'es' | 'en';
  frontmatter?: {
    title?: string;
    description?: string;
  };
  children: import('astro').HTMLContent;
}

const { lang, frontmatter, children } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={frontmatter?.description || 'AI Engineer Wiki — Bilingual technical documentation'} />
    <title>{frontmatter?.title ? `${frontmatter.title} — AI Engineer Wiki` : 'AI Engineer Wiki'}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
