---
import BaseLayout from './BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Sidebar from '../components/Sidebar.astro';
import SearchBar from '../components/SearchBar.astro';
import type { SearchItem } from '../components/SearchBar.astro';
import { buildSearchIndex } from '../search-index.js';
import { getNavigation } from '../navigation.js';

interface Props {
  lang: 'es' | 'en';
  frontmatter?: {
    title?: string;
    description?: string;
  };
  currentSlug?: string;
  searchResults?: SearchItem[];
}

const { lang, frontmatter, currentSlug, searchResults = [] } = Astro.props;
const isEn = lang === 'en';
const allSearch = buildSearchIndex();
---

<BaseLayout lang={lang} frontmatter={frontmatter}>
  <NavBar lang={lang} isEn={isEn} />
  <Sidebar lang={lang} currentSlug={currentSlug} />
  <main class="main-content">
    <div class="container">
      <SearchBar lang={lang} searchResults={searchResults} isOpen={false} />
      <slot />
    </div>
  </main>
</BaseLayout>
