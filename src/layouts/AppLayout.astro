---
import BaseLayout from './BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  lang: 'es' | 'en';
  frontmatter?: {
    title?: string;
    description?: string;
  };
  currentSlug?: string;
}

const { lang, frontmatter, currentSlug } = Astro.props;
const isEn = lang === 'en';
---

<BaseLayout lang={lang} frontmatter={frontmatter}>
  <NavBar lang={lang} isEn={isEn} />
  <Sidebar lang={lang} currentSlug={currentSlug} />
  <main class="main-content">
    <div class="container">
      <slot />
    </div>
  </main>
</BaseLayout>
